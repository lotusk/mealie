<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.mealie.backend.persistence.mapper.UserSelfMapper">

    <resultMap id="userSelfRow" type="io.mealie.backend.persistence.model.UserSelfRow">
        <constructor>
            <idArg column="id" javaType="java.util.UUID"
                   typeHandler="io.mealie.backend.persistence.typehandler.UuidTypeHandler"/>
            <arg column="username" javaType="java.lang.String"/>
            <arg column="full_name" javaType="java.lang.String"/>
            <arg column="email" javaType="java.lang.String"/>
            <arg column="auth_method" javaType="java.lang.String"/>
            <arg column="admin" javaType="java.lang.Boolean"/>
            <arg column="advanced" javaType="java.lang.Boolean"/>
            <arg column="show_announcements" javaType="java.lang.Boolean"/>
            <arg column="last_read_announcement" javaType="java.lang.String"/>
            <arg column="can_invite" javaType="java.lang.Boolean"/>
            <arg column="can_manage" javaType="java.lang.Boolean"/>
            <arg column="can_manage_household" javaType="java.lang.Boolean"/>
            <arg column="can_organize" javaType="java.lang.Boolean"/>
            <arg column="group_id" javaType="java.util.UUID"
                 typeHandler="io.mealie.backend.persistence.typehandler.UuidTypeHandler"/>
            <arg column="group_name" javaType="java.lang.String"/>
            <arg column="group_slug" javaType="java.lang.String"/>
            <arg column="household_id" javaType="java.util.UUID"
                 typeHandler="io.mealie.backend.persistence.typehandler.UuidTypeHandler"/>
            <arg column="household_name" javaType="java.lang.String"/>
            <arg column="household_slug" javaType="java.lang.String"/>
            <arg column="cache_key" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <resultMap id="userSelfTokenRow" type="io.mealie.backend.persistence.model.UserSelfTokenRow">
        <constructor>
            <idArg column="id" javaType="int"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.OffsetDateTime"
                 typeHandler="io.mealie.backend.persistence.typehandler.OffsetDateTimeTypeHandler"/>
        </constructor>
    </resultMap>

    <select id="findById" resultMap="userSelfRow">
        SELECT u.id, u.username, u.full_name, u.email, u.auth_method,
               u.admin, u.advanced, u.show_announcements, u.last_read_announcement,
               u.can_invite, u.can_manage, u.can_manage_household, u.can_organize,
               u.group_id, g.name AS group_name, g.slug AS group_slug,
               u.household_id, h.name AS household_name, h.slug AS household_slug, u.cache_key
        FROM users u
        JOIN groups g ON g.id = u.group_id
        JOIN households h ON h.id = u.household_id
        WHERE u.id = #{id}
    </select>

    <select id="findTokens" resultMap="userSelfTokenRow">
        SELECT id, name, created_at
        FROM long_live_tokens
        WHERE user_id = #{userId}
        ORDER BY id
    </select>
</mapper>
