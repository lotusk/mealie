<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.mealie.backend.persistence.mapper.GroupMemberMapper">

    <resultMap id="memberRow" type="io.mealie.backend.persistence.model.GroupMemberRow">
        <constructor>
            <idArg column="id" javaType="java.util.UUID"
                   typeHandler="io.mealie.backend.persistence.typehandler.UuidTypeHandler"/>
            <arg column="group_id" javaType="java.util.UUID"
                 typeHandler="io.mealie.backend.persistence.typehandler.UuidTypeHandler"/>
            <arg column="household_id" javaType="java.util.UUID"
                 typeHandler="io.mealie.backend.persistence.typehandler.UuidTypeHandler"/>
            <arg column="username" javaType="java.lang.String"/>
            <arg column="full_name" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <resultMap id="idRow" type="io.mealie.backend.persistence.model.IdRow">
        <constructor>
            <idArg column="id" javaType="java.util.UUID"
                   typeHandler="io.mealie.backend.persistence.typehandler.UuidTypeHandler"/>
        </constructor>
    </resultMap>

    <!-- Only validated SqlFragments are interpolated; user values remain bound parameters.
         All three queries receive the authenticated group scope, including random-order ID reads. -->
    <select id="count" resultType="long">
        SELECT count(*) FROM users WHERE ${where.sql}
    </select>

    <select id="ids" resultMap="idRow">
        SELECT users.id FROM users WHERE ${where.sql}
    </select>

    <select id="page" resultMap="memberRow">
        SELECT users.id, users.group_id, users.household_id, users.username, users.full_name
        FROM users
        WHERE ${where.sql}
        <if test="order != null and !order.isEmpty()">ORDER BY ${order.sql}</if>
        <choose>
            <when test="limit != null">LIMIT #{limit}</when>
            <when test="sqlite">LIMIT -1</when>
        </choose>
        OFFSET #{offset}
    </select>
</mapper>
