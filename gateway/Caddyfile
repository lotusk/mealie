# Mealie migration gateway: one entry point (:8080) in front of the Python and Java backends.
# Edits are picked up automatically (caddy runs with --watch); no restart needed.
# See docs/rebuild/gateway.md.
{
	auto_https off
	admin off
}

:8080 {
	log {
		output stdout
		format console
	}

	# Tag every response with the backend that served it: "X-Mealie-Backend: python" or "java".
	map {http.reverse_proxy.upstream.hostport} {mealie_backend} {
		{$JAVA_UPSTREAM} java
		{$PYTHON_UPSTREAM} python
		default none
	}
	header >X-Mealie-Backend {mealie_backend}

	# ---------------------------------------------------------------------------------------------
	# Routing table.
	#
	# Anything without a more specific rule goes to Python (all of /api/*, plus /docs and
	# /openapi.json). Caddy sorts these lines by path specificity, longest first, so their order in
	# the file doesn't matter.
	#
	# To move a route to Java, add one line, for example:
	#     reverse_proxy /api/foods* {$JAVA_UPSTREAM}
	# "/api/foods*" is a plain prefix: it covers /api/foods and /api/foods/{id}, and would also
	# cover a sibling such as /api/foodsearch. To send a sub-path back to Python, add a longer rule
	# for it that points at {$PYTHON_UPSTREAM}.
	# ---------------------------------------------------------------------------------------------

	# Backend-to-backend only: the Java backend publishes events through Python here (signed, but never exposed).
	respond /api/internal/* 404

	reverse_proxy /api/app/about {$JAVA_UPSTREAM}
	reverse_proxy /api/app/about/theme {$JAVA_UPSTREAM}
	reverse_proxy /api/app/about/startup-info {$JAVA_UPSTREAM}

	# POST only: Python continues to own refresh, logout and OIDC.
	@authToken {
		method POST
		path /api/auth/token
	}
	reverse_proxy @authToken {$AUTH_TOKEN_UPSTREAM:host.docker.internal:9100}

	# Exact authenticated profile and ratings list reads; the selected rating write is routed separately below.
	@userSelf {
		method GET
		path /api/users/self
	}
	reverse_proxy @userSelf {$JAVA_UPSTREAM}
	@userRatings {
		method GET
		path /api/users/self/ratings
	}
	reverse_proxy @userRatings {$JAVA_UPSTREAM}

	# Canary rating write: all other user rating paths and HTTP methods retain their existing routing.
	@userRatingWrite {
		method POST
		path /api/users/7c242f6f-fd24-4721-aea7-23018b37da88/ratings/korean-style-rice-bowl-1
	}
	reverse_proxy @userRatingWrite {$JAVA_UPSTREAM}

	# Exact group summary; preferences, settings and writes remain on Python.
	@groupSelf {
		method GET
		path /api/groups/self
	}
	reverse_proxy @groupSelf {$JAVA_UPSTREAM}

	# Exact member listing only; member detail and other methods remain on Python.
	@groupMembers {
		method GET
		path /api/groups/members
	}
	reverse_proxy @groupMembers {$JAVA_UPSTREAM}

	# Food listing only; food detail, empty, merge and writes stay on Python.
	@foodList {
		method GET
		path /api/foods
	}
	reverse_proxy @foodList {$JAVA_UPSTREAM}

	# Exact group household listing; detail routing is handled separately below.
	@groupHouseholds {
		method GET
		path /api/groups/households
	}
	reverse_proxy @groupHouseholds {$JAVA_UPSTREAM}

	# Canary migration: only this household detail GET moves; other detail URLs keep their current backend.
	@groupHouseholdDetail {
		method GET
		path /api/groups/households/9980e273-156a-4cb7-8488-299be07defc4
	}
	reverse_proxy @groupHouseholdDetail {$JAVA_UPSTREAM}

	# Manual creation moves only this exact POST. Imports and other writes remain on Python.
	@recipeCreate {
		method POST
		path /api/recipes
	}
	reverse_proxy @recipeCreate {$JAVA_UPSTREAM}

	# Exact duplication POST only; imports, other writes and duplicate-path GET stay on Python.
	@recipeDuplicate {
		method POST
		path_regexp recipeDuplicate ^/api/recipes/[^/]+/duplicate$
	}
	reverse_proxy @recipeDuplicate {$JAVA_UPSTREAM}

	# Only the last-made PATCH moves; other recipe writes and timeline APIs stay on Python.
	@recipeLastMade {
		method PATCH
		path_regexp recipeLastMade ^/api/recipes/[^/]+/last-made$
	}
	reverse_proxy @recipeLastMade {$JAVA_UPSTREAM}

	# Internal event delivery is accessible only by a direct, signed service call.
	respond /internal/* 404

	# Recipe detail GET and exact listing GET are migrated. Fixed sibling routes and other methods stay on Python.
	@recipeGet {
		method GET
		path_regexp recipeGet ^/api/recipes/[^/]+$
		not path /api/recipes/suggestions /api/recipes/exports
	}
	@recipeList {
		method GET
		path /api/recipes
	}
	reverse_proxy @recipeList {$JAVA_UPSTREAM}
	reverse_proxy @recipeGet {$JAVA_UPSTREAM}
	# Only exact tag creation uses Java; other tag paths and methods fall back to Python.
	@tagCreate {
		method POST
		path /api/organizers/tags
	}
	reverse_proxy @tagCreate {$JAVA_UPSTREAM}
	# Only exact category creation moves to Java; all other category requests fall back to Python.
	@categoryCreate {
		method POST
		path /api/organizers/categories
	}
	reverse_proxy @categoryCreate {$JAVA_UPSTREAM}
	@toolList {
		method GET
		path /api/organizers/tools
	}
	reverse_proxy @toolList {$JAVA_UPSTREAM}
	@toolCreate {
		method POST
		path /api/organizers/tools
	}
	reverse_proxy @toolCreate {$JAVA_UPSTREAM}
	@shoppingListGet {
		method GET
		path /api/households/shopping/lists
	}
	reverse_proxy @shoppingListGet {$JAVA_UPSTREAM}
	@householdStatisticsGet {
		method GET
		path /api/households/statistics
	}
	reverse_proxy @householdStatisticsGet {$JAVA_UPSTREAM}
	reverse_proxy {$PYTHON_UPSTREAM}
}
